# 生产推荐阿里云 RDS MySQL 8.4 内网地址；小程序不会直接接触这些信息。
DB_URL=jdbc:mysql://your-rds-host:3306/soft_energy_prod?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=REQUIRED
DB_USERNAME=softenergy_app
DB_PASSWORD=replace-with-rds-password
DB_POOL_MAX=8
DB_POOL_MIN=2
SERVER_PORT=8081
JWT_SECRET_BASE64=replace-with-at-least-32-random-bytes-in-base64
PHONE_KEY_BASE64=replace-with-32-random-bytes-in-base64
PHONE_HMAC_BASE64=replace-with-an-independent-random-base64-secret
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_CONTENT_SECURITY_ENABLED=true
ADMIN_ORIGIN=https://admin.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-initial-password
ADMIN_DISPLAY_NAME=内容管理员
