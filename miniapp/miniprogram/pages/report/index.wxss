.report-page{min-height:100vh;padding-bottom:70rpx}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.report-body{padding:8rpx 28rpx}.report-hero{padding:34rpx;display:flex;align-items:flex-start;gap:24rpx;color:#fff;border-radius:35rpx;background:var(--pine)}.hero-mark{width:72rpx;height:72rpx;display:grid;place-items:center;flex:0 0 auto;color:#70572f;border-radius:22rpx 22rpx 22rpx 7rpx;background:#dfcea2;font-family:var(--serif);font-size:34rpx}.report-hero>view:last-child{display:grid;gap:12rpx}.report-hero text:first-child{font-family:var(--serif);font-size:34rpx;font-weight:700}.hero-copy{color:rgba(255,255,255,.68);font-size:23rpx;line-height:1.72}.target-card{margin-top:22rpx;padding:24rpx}.section-kicker{color:var(--cinnabar);font-size:21rpx;font-weight:700;letter-spacing:.14em}.target-card>view{margin-top:14rpx;display:grid;gap:6rpx}.target-card>view>text:first-child{font-size:29rpx;font-weight:700}.target-card>view>text:last-child{color:var(--ink-soft);font-size:21rpx}.section-head{padding:39rpx 5rpx 18rpx;display:flex;align-items:end;justify-content:space-between}.section-head>text:last-child{color:var(--ink-soft);font-size:21rpx}.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.type-card{position:relative;min-height:150rpx;padding:22rpx;display:grid;align-content:start;gap:8rpx;border:1rpx solid var(--paper-deep);border-radius:23rpx;background:var(--white)}.type-card>text:nth-child(2){font-size:26rpx;font-weight:700}.type-card>text:last-child{padding-right:20rpx;color:var(--ink-soft);font-size:20rpx;line-height:1.5}.type-check{position:absolute;right:17rpx;top:17rpx;width:32rpx;height:32rpx;display:grid;place-items:center;color:#fff;border:1rpx solid #d8d3c8;border-radius:50%;font-size:19rpx}.type-card.selected{border-color:#bd8c83;background:#fbf3f1;box-shadow:inset 0 0 0 1rpx #bd8c83}.type-card.selected .type-check{border-color:var(--cinnabar);background:var(--cinnabar)}.type-card.disabled{opacity:.42}.description-card{margin-top:24rpx;padding:27rpx}.description-card>view{display:flex;justify-content:space-between}.description-card>view text:first-child{font-size:28rpx;font-weight:700}.description-card>view text:last-child{color:var(--ink-soft);font-size:21rpx}.description-card textarea{width:100%;min-height:210rpx;margin-top:20rpx;color:var(--ink);font-size:27rpx;line-height:1.7}.report-placeholder{color:#aaa9a4}.privacy-tip{display:block;padding-top:17rpx;color:var(--ink-soft);border-top:1rpx solid var(--paper-deep);font-size:20rpx;line-height:1.6}.report-error{margin:17rpx 3rpx 0;color:#a23f37;font-size:23rpx}.primary-button{margin-top:24rpx}.contact-button{height:88rpx;margin-top:15rpx;color:var(--pine);border:0;background:transparent;font-size:24rpx}.contact-button::after{border:0}.history-head{padding:43rpx 5rpx 18rpx;display:flex;justify-content:space-between}.history-head>text:last-child{color:var(--ink-soft);font-size:21rpx}.report-list{display:grid;gap:15rpx}.report-item{padding:24rpx}.report-item__top{display:flex;align-items:center;justify-content:space-between}.report-item__top>text:first-child{font-size:27rpx;font-weight:700}.status{padding:6rpx 13rpx;border-radius:99rpx;color:#8b6432;background:#f3ead7;font-size:19rpx}.status-PROCESSING{color:#496479;background:#e6edf1}.status-RESOLVED{color:#3f6650;background:#e4ede6}.status-REJECTED{color:#73756f;background:#ecebe7}.report-target{display:block;margin-top:8rpx;color:var(--ink-soft);font-size:20rpx}.report-description{display:block;margin-top:17rpx;font-size:23rpx;line-height:1.65}.handling-note{margin-top:17rpx;padding:17rpx;border-radius:16rpx;background:var(--paper);display:grid;gap:7rpx}.handling-note>text:first-child{color:var(--pine);font-size:20rpx;font-weight:700}.handling-note>text:last-child{font-size:22rpx;line-height:1.6}.empty-history{padding:48rpx;display:grid;gap:9rpx;text-align:center;color:var(--ink-soft)}.empty-history>text:first-child{color:var(--ink);font-family:var(--serif);font-size:29rpx}.empty-history>text:last-child{font-size:21rpx}.loading{padding:40rpx 0}@media(min-width:700px){.report-body{max-width:720rpx;margin:0 auto}}
