.privacy-page{min-height:100vh;padding-bottom:60rpx}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.privacy-body{padding:8rpx 28rpx}.privacy-hero{position:relative;min-height:330rpx;padding:43rpx 38rpx;display:flex;align-items:flex-start;flex-direction:column;overflow:hidden;color:#fff;border-radius:40rpx;background:var(--pine)}.privacy-orbit{position:absolute;right:-95rpx;top:-120rpx;width:350rpx;height:350rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:50%;box-shadow:0 0 0 48rpx rgba(255,255,255,.025),0 0 0 96rpx rgba(255,255,255,.018)}.shield{position:relative;width:70rpx;height:70rpx;display:grid;place-items:center;color:#72572f;border-radius:23rpx 23rpx 23rpx 7rpx;background:#e1d1a7;font-family:var(--serif);font-size:35rpx}.privacy-hero>text{position:relative;display:block;max-width:520rpx;margin-top:29rpx;font-family:var(--serif);font-size:42rpx;font-weight:700;line-height:1.5}.privacy-hero>.semantic-small{position:relative;display:block;margin-top:17rpx;color:rgba(255,255,255,.68);font-size:25rpx;line-height:1.75}.data-title{padding:47rpx 7rpx 22rpx;display:grid;gap:8rpx}.data-title>text:last-child{font-family:var(--serif);font-size:37rpx;font-weight:700}.data-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.data-grid>view{min-height:148rpx;padding:22rpx;display:flex;align-items:flex-start;gap:15rpx;border:1rpx solid var(--paper-deep);border-radius:25rpx;background:var(--white)}.data-grid .semantic-icon{width:46rpx;height:46rpx;display:grid;place-items:center;flex:0 0 auto;color:#fff;border-radius:14rpx 14rpx 14rpx 5rpx;background:var(--cinnabar);font-family:var(--serif);font-size:23rpx;font-style:normal}.data-grid .semantic-copy{display:grid;gap:7rpx}.data-grid .semantic-strong{font-size:25rpx}.data-grid .semantic-small{color:var(--ink-soft);font-size:21rpx;line-height:1.5}.privacy-actions{margin-top:26rpx;overflow:hidden}.privacy-actions>view{min-height:112rpx;padding:21rpx 25rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--paper-deep)}.privacy-actions>view:last-child{border:0}.privacy-actions>view>view{display:grid;gap:6rpx}.privacy-actions text{font-size:27rpx;font-weight:650}.privacy-actions .semantic-small{color:var(--ink-soft);font-size:21rpx}.privacy-actions .semantic-span{color:var(--cinnabar);font-size:40rpx}.contact-button{height:96rpx;margin-top:24rpx;display:flex;align-items:center;justify-content:center;color:var(--pine);border:1rpx solid #cfd8d1;border-radius:23rpx;background:#edf2ee;font-size:27rpx;font-weight:650}.contact-button::after{border:0}.privacy-footnote{display:block;margin-top:23rpx;color:#8a8d88;font-size:21rpx;text-align:center}
