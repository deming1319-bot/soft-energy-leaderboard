.profile-page{padding-inline:28rpx}.nav{padding-left:6rpx;padding-right:190rpx}.privacy{padding:12rpx 17rpx;color:var(--cinnabar);border-radius:14rpx;background:#f3e5e1;font-size:23rpx}.loading{padding:220rpx 0;text-align:center}.profile-card{position:relative;margin-top:16rpx;padding:38rpx 34rpx 28rpx;overflow:hidden;color:#fff;border-radius:42rpx;background:var(--pine)}.profile-pattern{position:absolute;right:-90rpx;top:-110rpx;width:340rpx;height:340rpx;border:1rpx solid rgba(255,255,255,.08);border-radius:50%;box-shadow:0 0 0 45rpx rgba(255,255,255,.025),0 0 0 90rpx rgba(255,255,255,.02)}.profile-main{position:relative;z-index:1;display:flex;align-items:center;gap:20rpx}.avatar{width:100rpx;height:100rpx;display:grid;place-items:center;color:#7c5d2e;border-radius:31rpx 31rpx 31rpx 10rpx;background:#decda1;font-family:var(--serif);font-size:44rpx}.profile-main>view:last-child{display:grid;gap:8rpx}.profile-main text{font-family:var(--serif);font-size:36rpx;font-weight:700;letter-spacing:3rpx}.profile-main .semantic-small{color:rgba(255,255,255,.6);font-size:22rpx}.profile-saying{position:absolute;right:33rpx;top:55rpx;color:#d1c095;font-family:var(--serif);font-size:21rpx}.profile-stats{margin-top:38rpx;padding-top:27rpx;display:flex;align-items:center;justify-content:space-around;border-top:1rpx solid rgba(255,255,255,.13)}.profile-stats>view{display:grid;gap:4rpx;text-align:center}.profile-stats text{font-family:var(--serif);font-size:38rpx;color:#eadbad}.profile-stats .semantic-small{color:rgba(255,255,255,.62);font-size:21rpx}.profile-stats>.semantic-icon{width:1rpx;height:38rpx;background:rgba(255,255,255,.12)}.privacy-note{margin-top:22rpx;padding:24rpx;display:flex;align-items:center;gap:16rpx;border-radius:24rpx;background:#e5ece6}.privacy-note>.privacy-note__mark{width:48rpx;height:48rpx;display:grid;place-items:center;flex-shrink:0;color:#fff;border-radius:15rpx;background:var(--pine);font-family:var(--serif)}.privacy-note>.semantic-copy{width:0;min-width:0;display:grid;flex-grow:1;gap:5rpx}.privacy-note .semantic-strong{color:var(--pine);font-size:24rpx}.privacy-note .semantic-small{color:var(--ink-soft);font-size:21rpx;line-height:1.55}.settings-head{padding:46rpx 6rpx 20rpx;display:grid;gap:8rpx}.settings-head>text:last-child{font-family:var(--serif);font-size:37rpx;font-weight:700}.settings-card{overflow:hidden}.settings-card>view{min-height:112rpx;padding:20rpx 25rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--paper-deep)}.settings-card>view:last-child{border:0}.settings-card>view>view{display:grid;gap:6rpx}.settings-card text{font-size:27rpx;font-weight:650}.settings-card .semantic-small{color:var(--ink-soft);font-size:21rpx}.settings-card .semantic-span{color:var(--cinnabar);font-size:39rpx}.history-head{padding:48rpx 6rpx 24rpx;display:flex;align-items:end;justify-content:space-between}.history-head>view{display:grid;gap:8rpx}.history-head>view>text:last-child{font-family:var(--serif);font-size:38rpx;font-weight:700;letter-spacing:3rpx}.history-head>.semantic-small{color:var(--ink-soft);font-size:21rpx}.history-list{display:grid;gap:18rpx}.history-item{min-height:122rpx;padding:21rpx 24rpx;display:grid;grid-template-columns:64rpx 1fr auto;align-items:center;gap:17rpx}.history-seal{width:60rpx;height:60rpx;display:grid;place-items:center;color:#77582d;border-radius:19rpx 19rpx 19rpx 6rpx;background:#eadbb5;font-family:var(--serif);font-size:26rpx}.grade-RUNNER_UP{color:#65536d;background:#e2d9e5}.grade-REVIEW_REQUIRED{color:var(--cinnabar-dark);background:#f0dcd7}.grade-UNRANKED{color:var(--ink-soft);background:#e6e8e5}.history-content{min-width:0;display:grid;gap:7rpx}.history-content text{overflow:hidden;font-family:var(--serif);font-size:27rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.history-content .semantic-small{color:var(--ink-soft);font-size:21rpx}.history-grade{display:flex;align-items:center;gap:10rpx;color:var(--cinnabar);font-size:23rpx}.history-grade .semantic-span{font-size:34rpx}.empty-state{display:grid;gap:14rpx}.empty-seal{width:72rpx;height:72rpx;margin:auto;display:grid;place-items:center;border:1rpx solid var(--paper-deep);border-radius:22rpx;font-family:var(--serif);font-size:30rpx}.empty-state text{font-family:var(--serif);font-size:29rpx}.empty-state .semantic-small{font-size:23rpx}
.reading-large .settings-card text,.reading-large .history-content text{font-size:31rpx}.reading-large .settings-card .semantic-small,.reading-large .privacy-note .semantic-small,.reading-large .history-content .semantic-small,.reading-large .history-head>.semantic-small{font-size:25rpx}.reading-large .history-grade{font-size:27rpx}
.settings-card>.test-center-entry{background:#edf2ee}.dev-badge{margin-left:9rpx;padding:4rpx 9rpx;color:#fff;border-radius:8rpx;background:var(--pine);font-size:18rpx;font-weight:600;vertical-align:3rpx}
