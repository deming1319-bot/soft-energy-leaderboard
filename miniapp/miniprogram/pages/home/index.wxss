.home{padding-inline:28rpx}.home-nav{padding-left:6rpx;padding-right:190rpx}.brand{display:flex;align-items:center;gap:16rpx}.brand__seal{width:68rpx;height:68rpx;display:grid;place-items:center;color:#fffaf2;border-radius:21rpx 21rpx 21rpx 7rpx;background:var(--cinnabar);font-family:var(--serif);font-size:37rpx;box-shadow:0 10rpx 24rpx rgba(137,59,49,.18)}.brand>view:last-child{display:grid;gap:2rpx}.brand text{font-family:var(--serif);font-size:34rpx;font-weight:700;letter-spacing:8rpx}.brand .semantic-small{color:var(--ink-soft);font-size:18rpx;letter-spacing:5rpx}.nav__motto{color:var(--ink-soft);font-family:var(--serif);font-size:20rpx;letter-spacing:2rpx}
.hero{position:relative;height:410rpx;margin-top:18rpx;overflow:hidden;color:#fff;border-radius:42rpx;background:var(--pine)}.hero__grain{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.05) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(255,255,255,.05) 1rpx,transparent 1rpx);background-size:45rpx 45rpx}.hero__moon{position:absolute;top:42rpx;right:50rpx;width:140rpx;height:140rpx;border-radius:50%;background:#d5c69f;opacity:.9}.hero__mountain{position:absolute;right:-40rpx;bottom:-5rpx;width:560rpx;height:260rpx;background:#394f42;clip-path:polygon(0 100%,23% 38%,40% 68%,62% 8%,100% 100%)}.mountain-b{right:auto;left:-80rpx;bottom:-58rpx;width:600rpx;height:250rpx;background:#526b5c;opacity:.8;clip-path:polygon(0 100%,17% 58%,36% 84%,58% 18%,75% 72%,88% 45%,100% 100%)}.hero__content{position:absolute;z-index:2;left:44rpx;top:68rpx;display:grid}.hero__overline{color:#cdbd92;font-size:19rpx;font-weight:700;letter-spacing:8rpx}.hero__title{margin-top:25rpx;font-family:var(--serif);font-size:50rpx;letter-spacing:5rpx}.hero__quote{margin-top:22rpx;color:rgba(255,255,255,.62);font-family:var(--serif);font-size:22rpx}.hero__status{position:absolute;z-index:3;right:38rpx;bottom:30rpx;display:flex;align-items:baseline;gap:8rpx}.hero__status text{font-family:var(--serif);font-size:48rpx;color:#e0d2aa}.hero__status .semantic-small{color:rgba(255,255,255,.58);font-size:18rpx}
.section-head{padding:52rpx 8rpx 26rpx;display:flex;align-items:end;justify-content:space-between}.section-head>view{display:grid;gap:10rpx}.section-head__title{font-family:var(--serif);font-size:40rpx;font-weight:700;letter-spacing:4rpx}.section-head__note{color:#8a8d88;font-size:20rpx}.loading{padding:100rpx 0}.activity-list{display:grid;gap:24rpx}.activity-card{position:relative;padding:30rpx 30rpx 0;overflow:hidden}.activity-card__top{display:flex;align-items:center;justify-content:space-between}.category-seal{width:60rpx;height:60rpx;display:grid;place-items:center;color:var(--cinnabar-dark);border:1rpx solid #e3c6c0;border-radius:18rpx 18rpx 18rpx 6rpx;background:#f7eae6;font-family:var(--serif);font-size:27rpx}.activity-state{padding:8rpx 14rpx;display:flex;align-items:center;gap:9rpx;border-radius:99rpx;color:var(--ink-soft);background:#f0eee8;font-size:20rpx}.activity-state .semantic-icon{width:10rpx;height:10rpx;border-radius:50%;background:currentColor}.state-ACTIVE{color:var(--pine);background:#e5ece6}.state-UPCOMING{color:#526b7b;background:#e7eef1}.activity-card__title{display:block;margin-top:25rpx;font-family:var(--serif);font-size:38rpx;font-weight:700;line-height:1.45;letter-spacing:2rpx}.activity-card__subtitle{display:block;margin-top:10rpx;color:var(--ink-soft);font-size:23rpx;line-height:1.7}.activity-card__divider{height:1rpx;margin:26rpx 0 19rpx;background:var(--paper-deep)}.activity-card__foot{display:flex;align-items:end;justify-content:space-between}.activity-card__foot>view:first-child{display:grid;gap:7rpx;color:var(--ink-soft);font-size:19rpx}.activity-card__foot>view:first-child .semantic-small{color:var(--cinnabar);font-weight:650}.participation{text-align:right}.participation text{display:block;font-family:var(--serif);font-size:34rpx}.participation .semantic-small{color:var(--ink-soft);font-size:18rpx}.activity-card__action{height:86rpx;margin:22rpx -30rpx 0;padding:0 30rpx;display:flex;align-items:center;justify-content:space-between;color:var(--cinnabar-dark);background:#faf4ef;font-weight:650;font-size:23rpx}.activity-card__action .semantic-span{font-size:40rpx;font-weight:300}.empty-state{display:grid;gap:18rpx}.empty-seal{width:76rpx;height:76rpx;margin:auto;display:grid;place-items:center;color:var(--ink-soft);border:1rpx solid var(--paper-deep);border-radius:24rpx;font-family:var(--serif);font-size:34rpx}.empty-state text{font-family:var(--serif);font-size:30rpx}.empty-state .semantic-small{font-size:21rpx}
.load-error{padding:60rpx 35rpx;display:grid;gap:14rpx;text-align:center}.load-error>view{width:68rpx;height:68rpx;margin:auto;display:grid;place-items:center;color:#fff;border-radius:22rpx 22rpx 22rpx 7rpx;background:var(--ink-soft);font-family:var(--serif);font-size:31rpx}.load-error>text{font-family:var(--serif);font-size:31rpx;font-weight:700}.load-error>.semantic-small{color:var(--ink-soft);font-size:23rpx;line-height:1.6}.load-error button{width:230rpx;height:82rpx;margin:13rpx auto 0;display:flex;align-items:center;justify-content:center;color:#fff;border-radius:20rpx;background:var(--cinnabar);font-size:25rpx}.load-error button::after{border:0}.brand .semantic-small{font-size:21rpx}.nav__motto,.section-head__note{font-size:23rpx}.hero__overline,.hero__status .semantic-small{font-size:22rpx}.hero__quote{font-size:25rpx}.activity-state{font-size:23rpx}.activity-card__subtitle,.activity-card__action{font-size:26rpx}.activity-card__foot>view:first-child,.participation .semantic-small{font-size:22rpx}.empty-state .semantic-small{font-size:24rpx}
.reading-large .activity-card__title{font-size:43rpx}.reading-large .activity-card__subtitle,.reading-large .activity-card__action{font-size:30rpx}.reading-large .activity-card__foot>view:first-child,.reading-large .participation .semantic-small,.reading-large .section-head__note{font-size:26rpx}
.home-filing{margin:54rpx 0 24rpx;padding:26rpx 20rpx;display:grid;gap:8rpx;color:#858982;text-align:center;border-top:1rpx solid var(--paper-deep);font-size:20rpx;line-height:1.5}.home-filing__tip{color:var(--cinnabar);font-size:19rpx}
