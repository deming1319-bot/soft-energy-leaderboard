.test-page{min-height:100vh;padding-bottom:70rpx}.nav{padding-inline:28rpx}.dev-mark{padding:7rpx 12rpx;color:#fff;border-radius:10rpx;background:var(--cinnabar);font-size:18rpx;font-weight:700;letter-spacing:2rpx}.test-body{padding:8rpx 28rpx}.test-hero{position:relative;min-height:382rpx;padding:38rpx 36rpx;overflow:hidden;color:#fff;border-radius:42rpx;background:var(--pine)}.hero-orbit{position:absolute;right:-95rpx;top:-125rpx;width:360rpx;height:360rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:50%;box-shadow:0 0 0 50rpx rgba(255,255,255,.025),0 0 0 100rpx rgba(255,255,255,.018)}.hero-seal{position:absolute;right:34rpx;bottom:38rpx;width:78rpx;height:78rpx;display:grid;place-items:center;color:#73582f;border-radius:25rpx 25rpx 25rpx 8rpx;background:#dfcfa4;font-family:var(--serif);font-size:36rpx}.test-hero>.eyebrow{position:relative;color:#dccb9f}.hero-title{position:relative;display:block;margin-top:20rpx;font-family:var(--serif);font-size:43rpx;font-weight:700;letter-spacing:3rpx}.hero-copy{position:relative;display:block;max-width:550rpx;margin-top:20rpx;color:rgba(255,255,255,.72);font-size:24rpx;line-height:1.75}.active-identity{position:relative;width:max-content;margin-top:24rpx;padding:12rpx 17rpx;display:flex;align-items:center;gap:12rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:14rpx;background:rgba(255,255,255,.08)}.active-identity text:first-child{color:rgba(255,255,255,.58);font-size:20rpx}.active-identity text:last-child{color:#eadbad;font-size:23rpx;font-weight:650}.section-heading{display:grid;gap:8rpx}.section-heading>text:nth-child(2){font-family:var(--serif);font-size:36rpx;font-weight:700}.section-heading>.semantic-small{color:var(--ink-soft);font-size:22rpx;line-height:1.6}.unlock-card{margin-top:25rpx;padding:31rpx}.field{margin-top:24rpx}.field>text{display:block;margin-bottom:11rpx;color:var(--ink-soft);font-size:22rpx;font-weight:650}.field input{height:92rpx;padding:0 22rpx;border:1rpx solid #ddd6ca;border-radius:19rpx;background:#faf8f3;font-size:27rpx}.unlock-button,.primary-action{height:96rpx;margin-top:28rpx;display:flex;align-items:center;justify-content:center;color:#fff;border:0;border-radius:22rpx;background:var(--cinnabar);font-size:27rpx;font-weight:650}.unlock-button::after,.primary-action::after,.exit-action::after,.reverify-action::after,.unavailable button::after{border:0}.unlock-button[disabled],.primary-action[disabled]{color:rgba(255,255,255,.7);background:#a9aaa6}.security-tip{display:block;margin-top:17rpx;color:#8a8d88;font-size:20rpx;text-align:center}.error-text{display:block;margin-top:18rpx;padding:14rpx 17rpx;color:var(--cinnabar-dark);border-radius:13rpx;background:#f5e7e3;font-size:22rpx;line-height:1.55}.error-text.standalone{margin:20rpx 0}.account-heading{padding:43rpx 7rpx 21rpx}.account-grid{display:grid;grid-template-columns:1fr 1fr;gap:15rpx}.account-item{min-height:116rpx;padding:18rpx;display:grid;grid-template-columns:43rpx 1fr 24rpx;align-items:center;gap:12rpx;border:1rpx solid #ddd7cb;border-radius:24rpx;background:var(--white);box-shadow:0 10rpx 25rpx rgba(55,47,38,.035)}.account-item.active{border-color:#758b7c;background:#e7eee8;box-shadow:0 11rpx 28rpx rgba(70,94,80,.1)}.account-index{color:#a18e72;font-size:19rpx;font-weight:700}.account-copy{min-width:0;display:grid;gap:7rpx}.account-copy text:first-child{font-family:var(--serif);font-size:28rpx;font-weight:700}.account-copy text:last-child{color:var(--ink-soft);font-size:19rpx}.account-item.active .account-copy text:last-child,.account-state{color:var(--pine)}.account-state{font-size:29rpx;font-weight:700}.loading-note{padding:50rpx 0;color:var(--ink-soft);text-align:center}.sync-card{margin-top:25rpx;padding:24rpx;display:flex;align-items:flex-start;gap:17rpx}.sync-seal{width:52rpx;height:52rpx;display:grid;place-items:center;flex:0 0 auto;color:#fff;border-radius:17rpx 17rpx 17rpx 6rpx;background:var(--pine);font-family:var(--serif);font-size:24rpx}.sync-card>view:last-child{display:grid;gap:7rpx}.sync-card>view:last-child text:first-child{font-size:25rpx;font-weight:650}.sync-card>view:last-child text:last-child{color:var(--ink-soft);font-size:21rpx;line-height:1.6}.exit-action,.reverify-action{height:86rpx;margin-top:16rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:24rpx}.exit-action{color:var(--cinnabar);border:1rpx solid #e1c8c2;background:#f7ece9}.reverify-action{color:var(--ink-soft);border:0;background:transparent}.unavailable{margin:90rpx 28rpx 0;padding:55rpx 38rpx;display:grid;justify-items:center;gap:18rpx;text-align:center}.state-seal{width:82rpx;height:82rpx;display:grid;place-items:center;color:#fff;border-radius:27rpx 27rpx 27rpx 8rpx;background:var(--pine);font-family:var(--serif);font-size:36rpx}.unavailable>text:nth-child(2){font-family:var(--serif);font-size:34rpx;font-weight:700}.unavailable>.semantic-small{color:var(--ink-soft);font-size:23rpx;line-height:1.7}.unavailable button{width:100%;height:88rpx;margin-top:10rpx;color:#fff;border:0;border-radius:20rpx;background:var(--pine);font-size:25rpx}
