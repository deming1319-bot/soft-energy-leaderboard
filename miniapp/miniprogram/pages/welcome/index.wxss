.welcome{position:relative;min-height:100vh;padding:58rpx 46rpx calc(40rpx + env(safe-area-inset-bottom));overflow:hidden;background:#f4f0e7}.welcome__orb{position:absolute;border-radius:50%;pointer-events:none}.orb-a{top:-180rpx;right:-190rpx;width:520rpx;height:520rpx;border:1rpx solid rgba(70,94,80,.12);box-shadow:0 0 0 70rpx rgba(70,94,80,.025),0 0 0 140rpx rgba(70,94,80,.018)}.orb-b{left:-260rpx;bottom:120rpx;width:430rpx;height:430rpx;background:rgba(157,73,61,.055)}.welcome__brand{position:relative;z-index:1;display:flex;align-items:center;gap:18rpx}.brand-seal{width:76rpx;height:76rpx;display:grid;place-items:center;color:#fffaf2;border-radius:23rpx 23rpx 23rpx 7rpx;background:var(--cinnabar);font-family:var(--serif);font-size:40rpx;box-shadow:0 14rpx 30rpx rgba(126,56,47,.18)}.welcome__brand>view:last-child{display:grid;gap:4rpx}.welcome__brand text{font-family:var(--serif);font-size:37rpx;font-weight:700;letter-spacing:9rpx}.welcome__brand .semantic-small{color:var(--ink-soft);font-size:22rpx;letter-spacing:3rpx}.welcome__hero{position:relative;z-index:1;margin-top:100rpx}.overline{display:block;color:var(--cinnabar);font-size:22rpx;font-weight:700;letter-spacing:8rpx}.welcome__title{display:block;margin-top:28rpx;font-family:var(--serif);font-size:72rpx;font-weight:700;line-height:1.32;letter-spacing:6rpx}.welcome__title>text{display:block}.welcome__copy{display:block;max-width:610rpx;margin-top:34rpx;color:var(--ink-soft);font-size:29rpx;line-height:1.9}.welcome__motto{margin-top:45rpx;display:flex;align-items:flex-start;gap:13rpx;color:var(--pine)}.welcome__motto .semantic-icon{font-family:Georgia,serif;font-size:52rpx;font-style:normal;line-height:.8}.welcome__motto text{font-family:var(--serif);font-size:28rpx;letter-spacing:2rpx}.agreement-card{position:relative;z-index:2;margin-top:82rpx;padding:30rpx 30rpx 28rpx;border:1rpx solid rgba(87,76,62,.12);border-radius:32rpx;background:rgba(255,254,251,.93);box-shadow:0 20rpx 60rpx rgba(55,47,38,.08)}.agreement-row{display:flex;align-items:flex-start;flex-wrap:wrap;gap:4rpx;color:var(--ink-soft);font-size:24rpx;line-height:1.7}.check{width:38rpx;height:38rpx;margin:1rpx 10rpx 0 0;display:grid;place-items:center;flex:0 0 auto;border:2rpx solid #b8b4aa;border-radius:12rpx;color:#fff;font-size:23rpx}.check.checked{border-color:var(--pine);background:var(--pine)}.link{color:var(--cinnabar);font-weight:650}.agreement-note{display:block;margin:18rpx 0 24rpx;color:#777d77;font-size:22rpx;line-height:1.65}.enter-button{height:104rpx;display:flex;align-items:center;justify-content:center;color:#fff;border:0;border-radius:24rpx;background:var(--cinnabar);font-size:30rpx;font-weight:700;letter-spacing:2rpx}.enter-button::after{border:0}.enter-button[disabled]{color:#9a9c97;background:#e8e4dc}.entry-error{margin-top:18rpx;color:#9a3f35;font-size:23rpx;text-align:center;line-height:1.5}.welcome__footer{position:relative;z-index:1;display:block;margin-top:28rpx;color:#8b8d88;font-size:21rpx;text-align:center;letter-spacing:1rpx}
