.legal-page{min-height:100vh;padding-bottom:70rpx;background:var(--paper)}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.legal-body{padding:7rpx 32rpx}.legal-head{padding:38rpx 12rpx 35rpx;border-bottom:1rpx solid var(--paper-deep)}.legal-head>text:nth-child(2){display:block;margin-top:18rpx;font-family:var(--serif);font-size:52rpx;font-weight:700;letter-spacing:4rpx}.legal-head>.semantic-small{display:block;margin-top:12rpx;color:var(--ink-soft);font-size:23rpx}.legal-head>view{display:inline-flex;margin-top:22rpx;padding:13rpx 18rpx;color:var(--cinnabar);border-radius:15rpx;background:#f3e5e1;font-size:23rpx;font-weight:650}.legal-intro{margin:28rpx 0;padding:24rpx 26rpx;color:var(--ink-soft);border-left:5rpx solid var(--gold);background:#f9f5eb;font-size:26rpx;line-height:1.85}.legal-section{padding:30rpx 8rpx;display:grid;grid-template-columns:50rpx 1fr;gap:20rpx;border-bottom:1rpx solid var(--paper-deep)}.section-no{width:46rpx;height:46rpx;display:grid;place-items:center;color:#fff;border-radius:14rpx 14rpx 14rpx 5rpx;background:var(--pine);font-family:var(--serif);font-size:23rpx}.legal-section>view:last-child>text{font-family:var(--serif);font-size:33rpx;font-weight:700}.legal-section .semantic-paragraph{margin:19rpx 0 0;color:#414841;font-size:28rpx;line-height:1.9;text-align:justify}.legal-end{padding:65rpx 20rpx;display:grid;gap:12rpx;text-align:center}.legal-end .semantic-icon{width:64rpx;height:64rpx;margin:auto;display:grid;place-items:center;color:#fff;border-radius:20rpx 20rpx 20rpx 7rpx;background:var(--cinnabar);font-family:var(--serif);font-size:31rpx;font-style:normal}.legal-end text{font-family:var(--serif);font-size:29rpx}.legal-end .semantic-small{color:var(--ink-soft);font-size:22rpx}
