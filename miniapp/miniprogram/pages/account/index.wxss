rder-radius:22rpx;background:#9a3f35;font-size:28rpx;font-weight:700}.cancel-button::after{border:0}.contact-button{height:92rpx;margin-top:22rpx;display:flex;align-items:center;justify-content:center;color:var(--pine);border:1rpx solid #d3dbd5;border-radius:22rpx;background:#edf2ee;font-size:26rpx}.contact-button::after{border:0}
