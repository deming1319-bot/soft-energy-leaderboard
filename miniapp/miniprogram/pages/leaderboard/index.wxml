<view class="board-page safe-top {{largeReading ? 'reading-large' : ''}}">
  <view class="nav"><view class="nav__back" bindtap="goBack">‹</view><text class="nav__title">荣誉榜单</text><view class="nav__placeholder"/></view>
  <view wx:if="{{loading}}" class="loading"><t-loading theme="circular" text="正在誊录榜单" /></view>
  <view wx:elif="{{error}}" class="page-error"><view class="page-error__mark">!</view><text>暂时没有读到榜单</text><text class="semantic-small">{{error}}</text><button bindtap="retry">重新加载</button><button class="page-error__secondary" bindtap="backHome">返回首页</button></view>
  <block wx:elif="{{board}}">
    <view class="board-head"><view class="board-head__pattern"/><text class="eyebrow">HONOUR ROLL</text><text class="board-head__title">{{board.activityTitle}}</text><text class="board-head__time">截止：{{endText}}</text><view class="board-head__counts"><view><text>{{champions.length}}</text><text class="semantic-small">冠军</text></view><view class="semantic-icon"/><view><text>{{runners.length}}</text><text class="semantic-small">亚军</text></view></view></view>
    <view wx:if="{{!board.revealed}}" class="locked-board"><view class="lock-orbit"><text>候</text></view><text>榜单尚未揭晓</text><text class="semantic-small">为保证公平，冠军与亚军排名将在答题截止后统一公布。</text><view wx:if="{{myGrade}}" class="my-result">我的当前结果：<text class="semantic-strong">{{myGrade}}</text></view></view>
    <view wx:else class="rank-content">
      <view class="rank-section champion-section"><view class="rank-section__head"><view class="rank-seal">冠</view><view><text>冠军榜</text><text class="semantic-small">完全正确 · 按首次答对时间排序</text></view></view><view class="rank-list"><view wx:for="{{champions}}" wx:key="userId" class="rank-row {{item.currentUser ? 'is-me' : ''}}"><view class="rank-no rank-{{item.rank}}">{{item.rank}}</view><view class="rank-avatar">{{item.initial}}</view><view class="rank-person"><text>{{item.displayName}}{{item.currentUser ? '（我）' : ''}}</text><text class="semantic-small">{{item.timeText}}</text></view><button wx:if="{{item.reportable}}" class="rank-report" data-user-id="{{item.userId}}" data-label="{{item.displayName}}" catchtap="reportUser">举报</button><text wx:elif="{{item.rank <= 3}}" class="laurel">✦</text></view><view wx:if="{{!champions.length}}" class="rank-empty">虚位以待</view></view></view>
      <view class="rank-section runner-section"><view class="rank-section__head"><view class="rank-seal">亚</view><view><text>亚军榜</text><text class="semantic-small">两句正确 · 上下联整体颠倒</text></view></view><view class="rank-list"><view wx:for="{{runners}}" wx:key="userId" class="rank-row {{item.currentUser ? 'is-me' : ''}}"><view class="rank-no">{{item.rank}}</view><view class="rank-avatar">{{item.initial}}</view><view class="rank-person"><text>{{item.displayName}}{{item.currentUser ? '（我）' : ''}}</text><text class="semantic-small">{{item.timeText}}</text></view><button wx:if="{{item.reportable}}" class="rank-report" data-user-id="{{item.userId}}" data-label="{{item.displayName}}" catchtap="reportUser">举报</button></view><view wx:if="{{!runners.length}}" class="rank-empty">暂无上下联颠倒的正确答案</view></view></view>
      <view class="rank-note">榜单只记录冠军与亚军；同一等级按首次达到该等级的时间先后排列。</view>
    </view>
  </block>
</view>
