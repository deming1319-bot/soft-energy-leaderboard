.board-page{min-height:100vh;padding-bottom:70rpx}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.loading{padding:220rpx 0;text-align:center}.board-head{position:relative;margin:12rpx 28rpx 0;padding:42rpx 36rpx 35rpx;overflow:hidden;color:#fff;border-radius:40rpx;background:var(--pine)}.board-head__pattern{position:absolute;right:-70rpx;top:-85rpx;width:300rpx;height:300rpx;border:1rpx solid rgba(255,255,255,.08);border-radius:50%;box-shadow:0 0 0 45rpx rgba(255,255,255,.025),0 0 0 90rpx rgba(255,255,255,.02)}.board-head .eyebrow{color:#d2c298}.board-head__title{position:relative;z-index:1;display:block;margin-top:18rpx;font-family:var(--serif);font-size:39rpx;font-weight:700;line-height:1.5;letter-spacing:3rpx}.board-head__time{display:block;margin-top:12rpx;color:rgba(255,255,255,.5);font-size:19rpx}.board-head__counts{margin-top:32rpx;padding-top:25rpx;display:flex;align-items:center;gap:35rpx;border-top:1rpx solid rgba(255,255,255,.12)}.board-head__counts>view{display:flex;align-items:baseline;gap:9rpx}.board-head__counts text{font-family:var(--serif);font-size:40rpx;color:#dfcfa3}.board-head__counts .semantic-small{font-size:19rpx;color:rgba(255,255,255,.6)}.board-head__counts .semantic-icon{width:1rpx;height:30rpx;background:rgba(255,255,255,.15)}.locked-board{padding:110rpx 65rpx;display:grid;gap:18rpx;text-align:center}.lock-orbit{width:150rpx;height:150rpx;margin:0 auto 20rpx;display:grid;place-items:center;border:1rpx solid #d9d1c5;border-radius:50%;box-shadow:0 0 0 22rpx rgba(221,213,199,.28)}.lock-orbit text{width:78rpx;height:78rpx;display:grid;place-items:center;color:#fff;border-radius:24rpx 24rpx 24rpx 8rpx;background:var(--ink-soft);font-family:var(--serif);font-size:35rpx}.locked-board>text{font-family:var(--serif);font-size:34rpx;font-weight:700}.locked-board>.semantic-small{color:var(--ink-soft);font-size:21rpx;line-height:1.7}.my-result{margin-top:15rpx;padding:18rpx;color:var(--ink-soft);border-radius:18rpx;background:var(--paper-deep);font-size:21rpx}.my-result .semantic-strong{color:var(--cinnabar)}.rank-content{padding:26rpx 28rpx}.rank-section{margin-bottom:24rpx;overflow:hidden;border:1rpx solid rgba(87,76,62,.11);border-radius:30rpx;background:var(--white)}.rank-section__head{padding:28rpx 30rpx;display:flex;align-items:center;gap:17rpx;background:#faf4e8}.runner-section .rank-section__head{background:#f1edf2}.rank-seal{width:62rpx;height:62rpx;display:grid;place-items:center;color:#785a2c;border-radius:19rpx 19rpx 19rpx 6rpx;background:#e6d3a4;font-family:var(--serif);font-size:29rpx}.runner-section .rank-seal{color:#65536d;background:#dcd2df}.rank-section__head>view:last-child{display:grid;gap:4rpx}.rank-section__head text{font-family:var(--serif);font-size:31rpx;font-weight:700}.rank-section__head .semantic-small{color:var(--ink-soft);font-size:18rpx}.rank-list{padding:8rpx 20rpx}.rank-row{min-height:102rpx;padding:15rpx 8rpx;display:grid;grid-template-columns:48rpx 64rpx 1fr 30rpx;align-items:center;gap:13rpx;border-bottom:1rpx solid #eee9df}.rank-row:last-child{border:0}.rank-row.is-me{margin-inline:-8rpx;padding-inline:16rpx;border-radius:18rpx;background:#f8ede9}.rank-no{color:var(--ink-soft);font-family:var(--serif);font-size:25rpx;text-align:center}.rank-1,.rank-2,.rank-3{font-size:30rpx;color:var(--gold);font-weight:700}.rank-avatar{width:60rpx;height:60rpx;display:grid;place-items:center;color:#fff;border-radius:19rpx 19rpx 19rpx 6rpx;background:var(--pine);font-family:var(--serif);font-size:26rpx}.rank-person{display:grid;gap:5rpx}.rank-person text{font-size:24rpx;font-weight:650}.rank-person .semantic-small{color:var(--ink-soft);font-size:18rpx}.laurel{color:var(--gold)}.rank-empty{padding:60rpx;color:#aaa59c;text-align:center;font-family:var(--serif);font-size:25rpx}.rank-note{padding:22rpx 25rpx;color:var(--ink-soft);border-radius:20rpx;background:var(--paper-deep);font-size:19rpx;line-height:1.65;text-align:center}
.page-error{padding:150rpx 70rpx;display:grid;justify-items:center;gap:18rpx;text-align:center}.page-error__mark{width:84rpx;height:84rpx;display:grid;place-items:center;color:var(--cinnabar);border-radius:28rpx;background:#efe0dc;font-family:var(--serif);font-size:42rpx;font-weight:700}.page-error>text{font-family:var(--serif);font-size:34rpx;font-weight:700}.page-error>.semantic-small{color:var(--ink-soft);font-size:24rpx;line-height:1.7}.page-error>button{width:100%;margin-top:16rpx;color:#fff;border-radius:22rpx;background:var(--cinnabar);font-size:28rpx}.page-error>.page-error__secondary{margin-top:0;color:var(--ink);background:transparent}
.reading-large .locked-board>.semantic-small,.reading-large .my-result,.reading-large .rank-section__head .semantic-small,.reading-large .rank-person .semantic-small,.reading-large .rank-note{font-size:24rpx}.reading-large .rank-person text{font-size:29rpx}.reading-large .rank-section__head text{font-size:35rpx}
