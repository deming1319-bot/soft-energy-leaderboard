.identity-page{min-height:100vh;padding-bottom:50rpx;background:var(--paper)}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.loading{padding:220rpx 0;text-align:center}.identity-body{padding:8rpx 28rpx}.identity-hero{position:relative;min-height:360rpx;padding:46rpx 40rpx;overflow:hidden;color:#fff;border-radius:42rpx;background:var(--pine)}.identity-ring{position:absolute;right:-100rpx;bottom:-130rpx;width:360rpx;height:360rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:50%;box-shadow:0 0 0 50rpx rgba(255,255,255,.025)}.overline{color:#d7c79b;font-size:21rpx;font-weight:700;letter-spacing:7rpx}.identity-title{position:relative;display:block;max-width:520rpx;margin-top:27rpx;font-family:var(--serif);font-size:52rpx;font-weight:700;line-height:1.45;letter-spacing:3rpx}.identity-copy{position:relative;display:block;margin-top:25rpx;color:rgba(255,255,255,.68);font-size:27rpx;line-height:1.8}.name-card{position:relative;margin:-24rpx 20rpx 0;padding:34rpx 30rpx}.name-card__head{display:flex;align-items:center;justify-content:space-between}.name-card__head text{font-family:var(--serif);font-size:32rpx;font-weight:700}.name-card__head .semantic-small{color:var(--ink-soft);font-size:22rpx}.name-input{height:100rpx;margin-top:24rpx;padding:0 25rpx;border:1rpx solid #d8d0c4;border-radius:22rpx;background:#faf8f3;font-size:31rpx}.name-placeholder{color:#aaa79f}.name-rule{margin:24rpx 0;display:flex;align-items:flex-start;gap:14rpx;color:var(--ink-soft);font-size:23rpx;line-height:1.7}.name-rule .semantic-icon{width:42rpx;height:42rpx;display:grid;place-items:center;flex:0 0 auto;color:#fff;border-radius:13rpx;background:var(--pine);font-family:var(--serif);font-style:normal}.form-error{margin:-5rpx 0 20rpx;color:#9a3f35;font-size:23rpx}.identity-footnote{display:block;margin-top:28rpx;color:#8d8f8a;font-size:22rpx;text-align:center}
