.result-page{min-height:100vh;padding-bottom:70rpx;background:var(--paper)}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.loading{padding:220rpx 0;text-align:center}.result-body{padding:10rpx 28rpx 50rpx}.result-hero{position:relative;min-height:460rpx;padding:45rpx 40rpx;display:flex;align-items:center;flex-direction:column;overflow:hidden;color:#fff;border-radius:42rpx;background:var(--pine)}.rings{position:absolute;top:50rpx;width:290rpx;height:290rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:50%;box-shadow:0 0 0 35rpx rgba(255,255,255,.025),0 0 0 75rpx rgba(255,255,255,.02)}.result-hero__eyebrow{color:#d2c298;font-size:19rpx;letter-spacing:7rpx}.honor-seal{position:relative;z-index:2;width:108rpx;height:108rpx;margin-top:30rpx;display:grid;place-items:center;color:#805d2d;border-radius:34rpx 34rpx 34rpx 10rpx;background:#e7d6a8;font-family:var(--serif);font-size:52rpx;box-shadow:0 14rpx 30rpx rgba(0,0,0,.14)}.grade-RUNNER_UP .honor-seal{color:#62506b;background:#ddd2e2}.grade-REVIEW_REQUIRED .honor-seal{color:#7e382f;background:#edd2cc}.grade-UNRANKED .honor-seal{color:#4f5b54;background:#d8dfd9}.result-hero__title{position:relative;z-index:2;margin-top:23rpx;font-family:var(--serif);font-size:48rpx;font-weight:700;letter-spacing:7rpx}.result-hero__feedback{position:relative;z-index:2;margin-top:10rpx;color:rgba(255,255,255,.66);font-size:21rpx;text-align:center}.score{position:absolute;right:28rpx;bottom:26rpx;display:grid;text-align:center}.score text{font-family:var(--serif);font-size:36rpx;color:#dccb9c}.score .semantic-small{color:rgba(255,255,255,.48);font-size:16rpx}.result-meta{position:relative;z-index:4;margin:-25rpx 22rpx 24rpx;padding:25rpx;display:grid;grid-template-columns:1fr 1rpx 1fr;gap:20rpx}.result-meta>view{display:grid;gap:7rpx}.result-meta .semantic-span{color:var(--ink-soft);font-size:18rpx}.result-meta text{overflow:hidden;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.result-meta>.semantic-icon{width:1rpx;background:var(--paper-deep)}.feedback-card,.answer-reveal{margin-top:24rpx;padding:32rpx}.feedback-card__title{display:block;margin-top:11rpx;font-family:var(--serif);font-size:34rpx;font-weight:700}.feedback-text{display:block;margin-top:20rpx;color:var(--ink-soft);font-size:24rpx;line-height:1.8}.matched{margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid var(--paper-deep)}.matched>text{display:block;margin-bottom:13rpx;color:var(--ink-soft);font-size:20rpx}.matched>view{margin-top:9rpx;display:flex;gap:10rpx;font-size:22rpx}.matched .semantic-icon{color:var(--pine);font-style:normal}.answer-reveal>view{display:flex;justify-content:space-between}.answer-reveal>view text{font-family:var(--serif);font-size:30rpx;font-weight:700}.answer-reveal>view .semantic-span{color:var(--pine);font-size:19rpx}.answer-reveal>text{display:block;margin-top:20rpx;white-space:pre-wrap;font-family:var(--serif);font-size:25rpx;line-height:1.9}.answer-locked{margin:24rpx 0;padding:35rpx;display:grid;gap:10rpx;text-align:center;color:var(--ink-soft);border:1rpx dashed #d2c9ba;border-radius:28rpx}.answer-locked>view{width:58rpx;height:58rpx;margin:auto;display:grid;place-items:center;border-radius:18rpx;background:var(--paper-deep);font-family:var(--serif)}.answer-locked>text{font-family:var(--serif);font-size:26rpx}.answer-locked .semantic-small{font-size:19rpx}.result-actions{margin-top:30rpx;display:grid;gap:16rpx}
.page-error{padding:150rpx 70rpx;display:grid;justify-items:center;gap:18rpx;text-align:center}.page-error__mark{width:84rpx;height:84rpx;display:grid;place-items:center;color:var(--cinnabar);border-radius:28rpx;background:#efe0dc;font-family:var(--serif);font-size:42rpx;font-weight:700}.page-error>text{font-family:var(--serif);font-size:34rpx;font-weight:700}.page-error>.semantic-small{color:var(--ink-soft);font-size:24rpx;line-height:1.7}.page-error>button{width:100%;margin-top:16rpx;color:#fff;border-radius:22rpx;background:var(--cinnabar);font-size:28rpx}.page-error>.page-error__secondary{margin-top:0;color:var(--ink);background:transparent}
.reading-large .result-hero__feedback,.reading-large .feedback-text,.reading-large .answer-reveal>text{font-size:30rpx}.reading-large .result-meta .semantic-span,.reading-large .matched>text,.reading-large .answer-locked .semantic-small{font-size:24rpx}.reading-large .result-meta text,.reading-large .matched>view,.reading-large .answer-locked>text{font-size:28rpx}
