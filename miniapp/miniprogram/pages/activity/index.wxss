.detail-page{padding-bottom:80rpx}.nav{padding-inline:28rpx}.nav__placeholder{width:68rpx}.loading{padding:200rpx 0;text-align:center}.question-head{padding:30rpx 38rpx 44rpx}.question-head__meta{display:flex;align-items:center;gap:18rpx}.category-seal{width:58rpx;height:58rpx;display:grid;place-items:center;color:var(--cinnabar-dark);border:1rpx solid #e3c6c0;border-radius:17rpx 17rpx 17rpx 6rpx;background:#f7eae6;font-family:var(--serif);font-size:26rpx}.state{padding:8rpx 14rpx;display:flex;align-items:center;gap:8rpx;color:var(--pine);border-radius:99rpx;background:#e5ece6;font-size:20rpx}.state .semantic-icon{width:9rpx;height:9rpx;border-radius:50%;background:var(--pine)}.question-head__title{display:block;margin-top:28rpx;font-family:var(--serif);font-size:50rpx;font-weight:700;line-height:1.35;letter-spacing:3rpx}.question-head__subtitle{display:block;margin-top:12rpx;color:var(--ink-soft);font-size:24rpx;line-height:1.7}.timebar{margin-top:35rpx;padding:22rpx 25rpx;display:flex;align-items:center;justify-content:space-between;color:#fff;border-radius:22rpx;background:var(--pine)}.timebar>view:first-child{display:grid;gap:5rpx;font-size:19rpx}.timebar .semantic-small{color:#d5c69f}.people{text-align:right}.people text{display:block;font-family:var(--serif);font-size:35rpx}.people .semantic-small{font-size:17rpx;color:rgba(255,255,255,.55)}.content-wrap{padding:0 28rpx;display:grid;gap:24rpx}.question-card,.answer-card{padding:32rpx}.card-label{display:flex;align-items:center;gap:12rpx;color:var(--ink-soft);font-size:22rpx;font-weight:650}.card-label .semantic-icon{width:44rpx;height:44rpx;display:grid;place-items:center;color:#fff;border-radius:14rpx 14rpx 14rpx 5rpx;background:var(--cinnabar);font-family:var(--serif);font-size:24rpx;font-style:normal}.question-text{display:block;margin-top:27rpx;white-space:pre-wrap;font-family:var(--serif);font-size:31rpx;line-height:2;letter-spacing:1rpx}.source{margin-top:29rpx;padding-top:20rpx;display:grid;gap:5rpx;color:var(--cinnabar-dark);border-top:1rpx solid var(--paper-deep);font-size:21rpx}.source .semantic-small{color:var(--ink-soft);font-size:19rpx}.answer-card__head{display:flex;align-items:center;justify-content:space-between}.answer-card__head>text{color:#9a9c97;font-size:19rpx}.answer-input{width:100%;min-height:360rpx;margin-top:24rpx;padding:25rpx;border:1rpx solid #ded7cb;border-radius:22rpx;background:#faf8f3;font-family:var(--serif);font-size:28rpx;line-height:1.9}.answer-placeholder{color:#aaa8a0}.answer-tip{margin:22rpx 0;display:flex;gap:12rpx;color:var(--ink-soft);font-size:20rpx;line-height:1.65}.answer-tip .semantic-icon{width:28rpx;height:28rpx;display:grid;place-items:center;flex:0 0 auto;color:var(--gold);border:1rpx solid var(--gold);border-radius:50%;font-style:normal;font-size:18rpx}.submit-btn{margin-top:6rpx}.attempts{display:block;margin-top:16rpx;color:#9a9c97;text-align:center;font-size:19rpx}.completed-card{padding:55rpx 36rpx;display:grid;gap:18rpx;text-align:center}.completed-seal{width:80rpx;height:80rpx;margin:auto;display:grid;place-items:center;color:#fff;border-radius:25rpx 25rpx 25rpx 8rpx;background:var(--cinnabar);font-family:var(--serif);font-size:36rpx}.muted-seal{background:var(--ink-soft)}.completed-card>text{font-family:var(--serif);font-size:34rpx;font-weight:700}.completed-card>.semantic-small{margin-bottom:15rpx;color:var(--ink-soft);font-size:21rpx;line-height:1.7}
.load-error{padding:150rpx 45rpx;display:grid;gap:15rpx;text-align:center}.load-error>view{width:70rpx;height:70rpx;margin:auto;display:grid;place-items:center;color:#fff;border-radius:22rpx;background:var(--ink-soft);font-family:var(--serif);font-size:32rpx}.load-error>text{font-family:var(--serif);font-size:32rpx;font-weight:700}.load-error>.semantic-small{color:var(--ink-soft);font-size:24rpx;line-height:1.6}.load-error button{width:230rpx;height:82rpx;margin:12rpx auto 0;color:#fff;border-radius:20rpx;background:var(--cinnabar);font-size:25rpx}.load-error button::after{border:0}.submit-error{margin:0 0 22rpx;padding:18rpx 20rpx;display:grid;gap:5rpx;color:#8d3b33;border-radius:17rpx;background:#f8e9e5}.submit-error text{font-size:24rpx;font-weight:650}.submit-error .semantic-small{font-size:21rpx;line-height:1.5}.state,.timebar>view:first-child,.people .semantic-small,.card-label,.source .semantic-small,.answer-card__head>text,.attempts{font-size:23rpx}.answer-tip,.completed-card>.semantic-small{font-size:24rpx}.reading-large .question-text{font-size:37rpx;line-height:2.05}.reading-large .answer-input{font-size:33rpx}.reading-large .answer-tip,.reading-large .source,.reading-large .completed-card>.semantic-small{font-size:27rpx}
