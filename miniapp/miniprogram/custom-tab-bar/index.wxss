.tabbar { position: fixed; z-index: 100; right: 26rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 26rpx; height: 112rpx; padding: 10rpx 90rpx; display: flex; align-items: center; justify-content: space-around; border: 1rpx solid rgba(75,65,53,.12); border-radius: 34rpx; background: rgba(255,254,251,.96); box-shadow: 0 18rpx 55rpx rgba(47,41,34,.16); backdrop-filter: blur(22rpx); }
.tabbar__item { position: relative; min-width: 120rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: #7a827c; font-size: 22rpx; }
.tabbar__glyph { width: 42rpx; height: 42rpx; display: grid; place-items: center; border: 1rpx solid #ddd5c7; border-radius: 13rpx 13rpx 13rpx 5rpx; font-family: "Songti SC", serif; font-size: 23rpx; }
.tabbar__item.active { color: #893b31; font-weight: 650; }
.tabbar__item.active .tabbar__glyph { color: #fffaf2; border-color: #9d493d; background: #9d493d; box-shadow: 0 7rpx 16rpx rgba(157,73,61,.18); }
